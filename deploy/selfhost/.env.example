# Copy to .env and fill in. Never commit the real file.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# Generate each with: python -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_APP_PASSWORD=
SESSION_SECRET=

# 32 random bytes, urlsafe base64:
#   python -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Back this up separately from the database: without it, stored provider keys cannot be decrypted.
ENCRYPTION_KEY=

# GitHub OAuth app: callback URL https://app.example.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Who may sign up: "allowlist" (recommended for a beta) or "open".
SIGNUP_MODE=allowlist
SIGNUP_ALLOWLIST=your-github-login

# Object storage. Defaults to the bundled SeaweedFS; for R2/S3 set the endpoint and keys,
# and S3_CREATE_BUCKET=false.
S3_BUCKET=replay-payloads
S3_ACCESS_KEY_ID=replay
S3_SECRET_ACCESS_KEY=change-me-and-match-s3.json
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_CREATE_BUCKET=false

ENABLE_SIMULATOR_PROVIDER=false
SENTRY_DSN=
METRICS_TOKEN=
BACKUP_KEEP_DAYS=14
