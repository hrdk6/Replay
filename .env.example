# Local development defaults (backend reads .env from the working directory).
# Production values are set in your host's secret manager - never commit a real .env.

ENV=development
DATABASE_URL=postgresql+asyncpg://replay:replay@localhost:5432/replay
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# Development-only secrets. Staging/production refuse to start with these values.
SESSION_SECRET=dev-only-session-secret-change-me-0123456789
ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzJieXRlcyE=

# Sign-in. Create a GitHub OAuth app with callback http://localhost:3000/api/auth/github/callback,
# or use development sign-in (dashboard login page) without one.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DEV_LOGIN_ENABLED=true
SIGNUP_MODE=open
SIGNUP_ALLOWLIST=

# Object storage (SeaweedFS from docker compose).
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:8333
S3_BUCKET=replay-payloads
S3_ACCESS_KEY_ID=replay
S3_SECRET_ACCESS_KEY=replay-dev-secret
S3_CREATE_BUCKET=true

# Built-in deterministic "simulator" models for demos and tests (disable in production).
ENABLE_SIMULATOR_PROVIDER=true

LOG_JSON=false
LOG_LEVEL=INFO
SENTRY_DSN=
METRICS_TOKEN=
